# ========================================================
# CONFIGURAÇÕES DO SERVIDOR
# ========================================================
PORT=3000
NODE_ENV=production
# URL pública do serviço em nuvem (ex: Render, Railway ou ngrok para testes locais)
APP_PUBLIC_URL=https://sua-aplicacao.onrender.com

# ========================================================
# TRELLO API (Gerar em: https://trello.com/power-ups/admin)
# ========================================================
TRELLO_API_KEY=sua_chave_de_api_trello
TRELLO_TOKEN=seu_token_de_acesso_trello
# ID do quadro "Projetos" da B2 Energia Solar (já capturado)
TRELLO_BOARD_ID=6a67bc403bcaf1d86f059114

# ========================================================
# META WHATSAPP CLOUD API OFICIAL (https://developers.facebook.com)
# ========================================================
# ID do número de telefone configurado na Meta
WHATSAPP_PHONE_NUMBER_ID=seu_phone_number_id
# ID da Conta do WhatsApp Business (WABA)
WHATSAPP_WABA_ID=seu_waba_id
# Token de acesso permanente gerado no Meta Business Manager (System User)
WHATSAPP_ACCESS_TOKEN=seu_access_token_permanente_meta
